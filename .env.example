# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DERIV_API_TOKEN: Server-side only token for Deriv WebSocket v3 API authentication.
# Used exclusively in the Express backend (server.ts) - never exposed to the client.
DERIV_API_TOKEN=""

# DERIV_APP_ID: Deriv Application ID (default: 1089 for standard public API).
DERIV_APP_ID="1089"

# Institutional Bootstrap Account Credentials (Rotated)
ADMIN_BOOTSTRAP_PASSWORD="YOUR_ROTATED_SECURE_ADMIN_PASSWORD"
ADMIN_BOOTSTRAP_2FA_SECRET="YOUR_ROTATED_2FA_SECRET"
TRADER_BOOTSTRAP_PASSWORD="YOUR_ROTATED_SECURE_TRADER_PASSWORD"
SESSION_SECRET="YOUR_HMAC_SHA256_SESSION_SECRET"
